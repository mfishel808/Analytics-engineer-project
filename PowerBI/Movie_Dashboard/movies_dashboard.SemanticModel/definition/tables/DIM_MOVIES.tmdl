	partition DIM_MOVIES = m
		mode: directQuery
		source = ```
				let
				    Source = Snowflake.Databases("GFVHJLE-HK92660.snowflakecomputing.com","STREAMSIGHT_WH",[Implementation="2.0"]),
				    STREAMSIGHT_Database = Source{[Name="STREAMSIGHT",Kind="Database"]}[Data],
				    PROD_MARTS_Schema = STREAMSIGHT_Database{[Name="PROD_MARTS",Kind="Schema"]}[Data],
				    DIM_MOVIES_Table = PROD_MARTS_Schema{[Name="DIM_MOVIES",Kind="Table"]}[Data],
				    #"Inserted Year" = Table.AddColumn(DIM_MOVIES_Table, "Year", each Date.Year([RELEASE_DATE]), Int64.Type),
				    #"Added Custom" = Table.AddColumn(#"Inserted Year", "year flag", each if [Year]>=(Date.Year(DateTime.LocalNow())-10) 
				and [Year]<= Date.Year(DateTime.LocalNow()) then "Y"
				else "N")
				in
				    #"Added Custom"
				```

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation


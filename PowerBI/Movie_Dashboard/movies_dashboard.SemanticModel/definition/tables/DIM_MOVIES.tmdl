table DIM_MOVIES
	lineageTag: a50b6b30-4558-4ef2-8351-b35bd1ae8175

	measure 'Movie Score' =
			
			VAR RatingScore =
			    DIVIDE(
			        MAX(DIM_MOVIES[AVERAGE_RATING]),
			        10
			    )
			
			VAR PopularityScore =
			    DIVIDE(
			        MAX(DIM_MOVIES[POPULARITY]),
			        CALCULATE(
			            MAX(DIM_MOVIES[POPULARITY]),
			            ALL(DIM_MOVIES)
			        )
			    )
			
			VAR RatingCountScore =
			    DIVIDE(
			        LOG(1 + MAX(DIM_MOVIES[RATING_COUNT])),
			        CALCULATE(
			            MAXX(
			                ALL(DIM_MOVIES),
			                LOG(1 + DIM_MOVIES[RATING_COUNT])
			            )
			        )
			    )
			
			RETURN
			    RatingScore * 0.45
			    + PopularityScore * 0.35
			    + RatingCountScore * 0.20
		lineageTag: 51b14f27-41f1-4c71-ae64-8c7b5f7cb665

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Movie Rank' =
			
			RANKX(
			    ALLSELECTED(DIM_MOVIES[MOVIE_ID]),
			    [Movie Score],
			    ,
			    DESC,
			    DENSE
			)
		formatString: 0
		lineageTag: 3c642361-6b1a-49d8-8c60-b65442e9a3a0

	measure 'Gross Earnings' = max(DIM_MOVIES[REVENUE])-max(DIM_MOVIES[BUDGET])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: ab6ceda8-06d4-437d-ae86-bff76ade0e1d


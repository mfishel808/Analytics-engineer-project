model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["BRIDGE_MOVIE_CREDITS","BRIDGE_MOVIE_GENRES","DIM_MOVIES","DIM_PEOPLE","REF_GENRES"]

annotation PBI_ProTooling = ["DevMode"]

ref table BRIDGE_MOVIE_CREDITS
ref table BRIDGE_MOVIE_GENRES
ref table DIM_MOVIES
ref table DIM_PEOPLE
ref table REF_GENRES

ref cultureInfo en-US

